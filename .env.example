# ─── Alert Email System (alerts/ module) ─────────────────────────────────────
# Used by the automatic real-time distress alert system.
# Set ALERT_SMTP_USER and ALERT_SMTP_PASSWORD to enable email alerts.

ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=womendistress.ai@gmail.com
# Gmail App Password — 16 chars, generated at:
# https://myaccount.google.com/apppasswords
# Enable 2-Step Verification first, then create an App Password.
ALERT_SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Backend Environment Variables ───────────────────────────────────────────

# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to git

# ─── SMTP Email (for emergency alerts) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Use a Gmail App Password — NOT your login password
# Generate at: Google Account → Security → 2-Step Verification → App passwords
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=your_email@gmail.com
ENABLE_EMAIL_ALERTS=true

# ─── CORS (for production deployment) ────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://your-app.vercel.app,https://your-custom-domain.com
# Leave empty for local development only (localhost:5173 is always allowed)
ALLOWED_ORIGINS=

# WebCam Configuration
WEBCAM_INDEX=0
WEBCAM_INFERENCE_EVERY_N=30
VIOLENCE_CONFIRMATION_COUNT=2

# Alert Feature Flags & Thresholds
ALERT_CONFIDENCE_THRESHOLD=75.0

ALERT_COOLDOWN_SECONDS=300
ALERT_MAX_RETRIES=2
ALERT_RETRY_DELAY_SECONDS=3.0

ALERT_CAMERA_ID=CAM-01
ALERT_CAMERA_LOCATION=Main Entrance
ALERT_GPS_LOCATION=N/A

# TextBee SMS Configuration
SMS_ENABLED=false
SMS_TO_NUMBER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
